"C++ snapshot test - control flow"
int factorial(int n) {
    if (n <= 1) return 1;
    else return n * factorial(n - 1);
}
void loop() {
    for (int i = 0; i < 10; i++) {
        if (i % 2 == 0) {
            std::cout << i << std::endl;
        } else {
            std::cout << "odd" << std::endl;
        }
    }
}
