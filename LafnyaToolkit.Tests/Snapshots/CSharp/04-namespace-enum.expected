using System;
using System.Collections.Generic;

namespace Example
{
    public enum Color
    {
        Red,
        Green,
        Blue
    }

    public struct Point
    {
        public int X;
        public int Y;
        public Point(int x, int y) { X = x; Y = y; }
    }

    public static class Utils
    {
        public static int Square(int n) { return n * n; }
        public static bool IsEven(int n) { return n % 2 == 0; }
    }
}
