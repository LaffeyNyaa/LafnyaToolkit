package com.example;
public enum Color { RED, GREEN, BLUE }
public class Point {
    public final int x;
    public final int y;
    public Point(int x, int y) { this.x = x; this.y = y; }
}
public final class Utils {
    public static int square(int n) { return n * n; }
    public static boolean isEven(int n) { return n % 2 == 0; }
}
